        document.getElementById('modal-job-id').value = job.id;
        document.getElementById('modal-title-input').value = job.title;
        document.getElementById('modal-category-input').value = job.category || (categories[0] ? categories[0].id : '');
        document.getElementById('modal-completed-input').checked = !!job.completed;
        document.getElementById('modal-date-input').value = job.date || '';
        document.getElementById('modal-time-input').value = job.time || '';
        document.getElementById('modal-notes-input').value = job.notes || '';
