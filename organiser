    function closeModal() {
      document.getElementById('job-modal').classList.add('hidden');
    }

    function renderSubtasksModal() {
      const container = document.getElementById('modal-subtasks-container');
      container.innerHTML = '';

      const job = jobs.find(j => j.id === activeJobId);
      const subtasks = job ? job.subtasks : [];
      const cat = job ? categories.find(c => c.id === job.category) : null;
      const catColor = cat ? cat.color : '#6366f1';

      subtasks.forEach((st, idx) => {
        const item = document.createElement('div');
        item.className = 'flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-lg p-2';
        const timeDisplay = st.time ? ` ${st.time}` : '';
        item.innerHTML = `
          <input type="checkbox" ${st.completed ? 'checked' : ''} onchange="toggleSubtask(${idx})" class="rounded border-slate-300 text-indigo-600">
          <span class="flex-1 text-xs text-slate-800 ${st.completed ? 'line-through text-slate-400' : ''}">${st.title}</span>
          ${st.due ? `<span class="text-[10px] text-white px-2 py-0.5 rounded font-medium shadow-sm" style="background-color: ${catColor}">${st.due}${timeDisplay}</span>` : ''}
          <button onclick="removeSubtask(${idx})" class="text-slate-400 hover:text-red-600 text-xs px-1">&times;</button>
        `;
        container.appendChild(item);
      });
    }

    function addSubtask() {
      const titleInput = document.getElementById('new-subtask-title');
      const dateInput = document.getElementById('new-subtask-date');
      const timeInput = document.getElementById('new-subtask-time');

      if (!titleInput.value.trim()) return;

      const job = jobs.find(j => j.id === activeJobId);
      const newSubtask = {
        id: Date.now().toString(),
        title: titleInput.value.trim(),
        due: dateInput.value,
        time: timeInput.value,
        completed: false
      };

      if (job) {
        job.subtasks.push(newSubtask);
        renderSubtasksModal();
      }

      titleInput.value = '';
      dateInput.value = '';
      timeInput.value = '';
      saveData();
    }

    function toggleSubtask(index) {
      const job = jobs.find(j => j.id === activeJobId);
      if (job && job.subtasks[index]) {
        job.subtasks[index].completed = !job.subtasks[index].completed;
        renderSubtasksModal();
        saveData();
      }
    }

    function removeSubtask(index) {
      const job = jobs.find(j => j.id === activeJobId);
      if (job) {
        job.subtasks.splice(index, 1);
        renderSubtasksModal();
        saveData();
      }
    }

    function renderPhotosModal() {
      const container = document.getElementById('modal-photos-container');
      container.innerHTML = '';
      const job = jobs.find(j => j.id === activeJobId);
      if (!job || !job.photos) return;

      job.photos.forEach((src, idx) => {
        const div = document.createElement('div');
        div.className = 'relative group rounded border border-slate-200 overflow-hidden h-16 shadow-sm';
        div.innerHTML = `
          <img src="${src}" class="w-full h-full object-cover">
          <button onclick="removePhoto(${idx})" class="absolute top-1 right-1 bg-red-600 text-white rounded-full w-4 h-4 flex items-center justify-center text-xs opacity-0 group-hover:opacity-100 transition">&times;</button>
        `;
        container.appendChild(div);
      });
    }

    document.getElementById('modal-photo-upload').addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        const job = jobs.find(j => j.id === activeJobId);
        if (job) {
          if (!job.photos) job.photos = [];
          job.photos.push(evt.target.result);
          renderPhotosModal();
        }
      };
      reader.readAsDataURL(file);
    });

    function removePhoto(index) {
      const job = jobs.find(j => j.id === activeJobId);
      if (job && job.photos) {
        job.photos.splice(index, 1);
        renderPhotosModal();
      }
    }

    function saveJob() {
      const id = document.getElementById('modal-job-id').value;
      const title = document.getElementById('modal-title-input').value.trim();
      const category = document.getElementById('modal-category-input').value;
      const completed = document.getElementById('modal-completed-input').checked;
      const date = document.getElementById('modal-date-input').value;
      const time = document.getElementById('modal-time-input').value;
      const notes = document.getElementById('modal-notes-input').value.trim();

      if (!title) return;

      if (id) {
        const job = jobs.find(j => j.id === id);
        if (job) {
          job.title = title;
          job.category = category;
          job.completed = completed;
          job.date = date;
          job.time = time;
          job.notes = notes;
        }
      } else {
        const newJob = {
          id: Date.now().toString(),
          title: title,
          category: category,
          completed: completed,
          date: date,
          time: time,
          notes: notes,
          photos: [],
          subtasks: []
        };
        jobs.push(newJob);
      }

      closeModal();
      saveData();
    }

    function deleteJob() {
      if (!activeJobId) return;
      jobs = jobs.filter(j => j.id !== activeJobId);
      closeModal();
      saveData();
    }

