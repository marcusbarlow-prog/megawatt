    function handleSearch() {
      const term = document.getElementById('search-input').value.trim().toLowerCase();
      const container = document.getElementById('search-results-container');
      const searchOverlay = document.getElementById('view-search-results');

      if (!term) {
        searchOverlay.classList.add('hidden');
        switchView(currentView);
        return;
      }

      document.getElementById('view-list').classList.add('hidden');
      document.getElementById('view-calendar').classList.add('hidden');
      document.getElementById('view-day').classList.add('hidden');
      document.getElementById('view-archive').classList.add('hidden');
      searchOverlay.classList.remove('hidden');

      container.innerHTML = '';
      const matched = jobs.filter(j => {
        const matchTitle = j.title.toLowerCase().includes(term);
        const matchNotes = (j.notes || '').toLowerCase().includes(term);
        const matchSubtasks = j.subtasks.some(st => st.title.toLowerCase().includes(term));
        return matchTitle || matchNotes || matchSubtasks;
      });

      if (matched.length === 0) {
        container.innerHTML = `<div class="text-center py-12 text-slate-400 text-sm">No matching tasks or notes found.</div>`;
        return;
      }

      matched.forEach(j => {
        const row = createJobRow(j, j.completed);
        container.appendChild(row);
      });
    }

    function populateMonthJumpDropdown(selectedYear, selectedMonth) {
      const select = document.getElementById('month-jump-select');
      select.innerHTML = '';

      const today = new Date();
      const startYear = today.getFullYear() - 2;
      const endYear = today.getFullYear() + 3;

      for (let y = startYear; y <= endYear; y++) {
        for (let m = 0; m < 12; m++) {
          const dateObj = new Date(y, m, 1);
          const val = `${y}-${String(m + 1).padStart(2, '0')}`;
          const label = dateObj.toLocaleString('default', { month: 'long', year: 'numeric' });
          const opt = document.createElement('option');
          opt.value = val;
          opt.innerText = label;
          if (y === selectedYear && m === selectedMonth) {
            opt.selected = true;
          }
          select.appendChild(opt);
        }
      }
    }

    function jumpToMonth(val) {
      const [y, m] = val.split('-');
      currentCalendarDate = new Date(parseInt(y), parseInt(m) - 1, 1);
      renderCalendar();
    }

    function renderCalendar() {
      const grid = document.getElementById('calendar-grid');
      grid.innerHTML = '';

      const year = currentCalendarDate.getFullYear();
      const month = currentCalendarDate.getMonth();

      document.getElementById('calendar-month-year').innerText = new Date(year, month).toLocaleString('default', { month: 'long', year: 'numeric' });
      populateMonthJumpDropdown(year, month);

      const firstDayIndex = new Date(year, month, 1).getDay();
      const daysInCurrentMonth = new Date(year, month + 1, 0).getDate();
      const daysInPrevMonth = new Date(year, month, 0).getDate();

      const activeJobs = jobs.filter(j => !j.completed);

      function renderDayCell(dateStr, isCurrentMonth, dayNum, fullDateObj) {
        const cell = document.createElement('div');
        cell.className = `rounded-lg p-2 min-h-[90px] border flex flex-col gap-1 overflow-y-auto custom-scrollbar cursor-pointer shadow-sm ${isCurrentMonth ? 'bg-slate-50 border-slate-200 hover:border-indigo-400' : 'bg-slate-100/50 border-slate-200/60 opacity-40'}`;

        cell.onclick = (e) => {
          if (e.target === cell || e.target.classList.contains('day-num-header')) {
            currentDayDate = fullDateObj;
            switchView('day');
          }
        };

        const dayHeader = document.createElement('div');
        dayHeader.className = 'flex justify-between items-center day-num-header';
        const dayNumSpan = document.createElement('span');
        dayNumSpan.className = `text-xs font-semibold day-num-header ${isCurrentMonth ? 'text-slate-700' : 'text-slate-400'}`;
        dayNumSpan.innerText = dayNum;
        dayHeader.appendChild(dayNumSpan);
        cell.appendChild(dayHeader);

        activeJobs.forEach(j => {
          const cat = categories.find(c => c.id === j.category);
          const catColor = cat ? cat.color : '#6366f1';

          // Main job tag
          if (j.date === dateStr) {
            const tag = document.createElement('div');
            tag.className = 'text-[10px] text-white p-1 rounded font-medium cursor-pointer truncate shadow-sm';
            tag.style.backgroundColor = catColor;
            const timeLabel = j.time ? `[${j.time}] ` : '';
            tag.innerText = `${timeLabel}${j.title}`;
            tag.onclick = (e) => { e.stopPropagation(); openModal(j.id); };
            cell.appendChild(tag);
          }

          // Subtask tag
          j.subtasks.filter(st => !st.completed).forEach(st => {
            if (st.due === dateStr) {
              const tag = document.createElement('div');
              tag.className = 'text-[10px] text-white p-1 rounded font-medium cursor-pointer truncate shadow-sm';
              tag.style.backgroundColor = catColor;
              const timeLabel = st.time ? `[${st.time}] ` : '';
              tag.innerText = `${timeLabel}${j.title}: ${st.title}`;
              tag.onclick = (e) => { e.stopPropagation(); openModal(j.id); };
              cell.appendChild(tag);
            }
          });
        });

        return cell;
      }

      // 1. Render trailing days from previous month
      for (let i = firstDayIndex - 1; i >= 0; i--) {
        const dayNum = daysInPrevMonth - i;
        const prevMonthDate = new Date(year, month - 1, dayNum);
        const dateStr = `${prevMonthDate.getFullYear()}-${String(prevMonthDate.getMonth() + 1).padStart(2, '0')}-${String(dayNum).padStart(2, '0')}`;
        grid.appendChild(renderDayCell(dateStr, false, dayNum, prevMonthDate));
      }

      // 2. Render current month days
      for (let day = 1; day <= daysInCurrentMonth; day++) {
        const dateObj = new Date(year, month, day);
        const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        grid.appendChild(renderDayCell(dateStr, true, day, dateObj));
      }

      // 3. Render leading days from next month
      const totalCellsSoFar = firstDayIndex + daysInCurrentMonth;
      const remainingCells = totalCellsSoFar <= 35 ? 35 - totalCellsSoFar : 42 - totalCellsSoFar;
      for (let day = 1; day <= remainingCells; day++) {
        const nextMonthDate = new Date(year, month + 1, day);
        const dateStr = `${nextMonthDate.getFullYear()}-${String(nextMonthDate.getMonth() + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        grid.appendChild(renderDayCell(dateStr, false, day, nextMonthDate));
      }
    }

    function prevMonth() {
      currentCalendarDate.setMonth(currentCalendarDate.getMonth() - 1);
      renderCalendar();
    }
    function nextMonth() {
      currentCalendarDate.setMonth(currentCalendarDate.getMonth() + 1);
      renderCalendar();
    }
    function todayMonth() {
      currentCalendarDate = new Date();
      renderCalendar();
    }

