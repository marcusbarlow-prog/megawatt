    // Availability / Quick Reference Modal
    function openAvailabilityModal() {
      const container = document.getElementById('availability-content');
      container.innerHTML = '';

      const activeJobs = jobs.filter(j => !j.completed);
      
      let timeline = [];
      activeJobs.forEach(j => {
        if (j.date) {
          timeline.push({ date: j.date, time: j.time || '', title: j.title, type: 'Job', cat: j.category, id: j.id });
        }
        j.subtasks.filter(st => !st.completed).forEach(st => {
          if (st.due) {
            timeline.push({ date: st.due, time: st.time || '', title: `${j.title}: ${st.title}`, type: 'Subtask', cat: j.category, id: j.id });
          }
        });
      });

      timeline.sort((a, b) => {
        if (a.date !== b.date) return a.date.localeCompare(b.date);
        return (a.time || '00:00').localeCompare(b.time || '00:00');
      });

      if (timeline.length === 0) {
        container.innerHTML = `<div class="text-center py-8 text-slate-400 text-sm">No scheduled due dates found for active tasks.</div>`;
      } else {
        const group = document.createElement('div');
        group.className = 'space-y-2';
        timeline.forEach(item => {
          const cat = categories.find(c => c.id === item.cat);
          const catColor = cat ? cat.color : '#6366f1';
          const catName = cat ? cat.name : '';

          const row = document.createElement('div');
          row.className = 'bg-slate-50 border border-slate-200 rounded-lg p-3 flex items-center justify-between gap-3 cursor-pointer hover:border-indigo-500 transition shadow-sm';
          row.onclick = () => {
            closeAvailabilityModal();
            openModal(item.id);
          };

          row.innerHTML = `
            <div class="flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background-color: ${catColor}"></span>
              <div>
                <h4 class="font-medium text-sm text-slate-900">${item.title}</h4>
                <p class="text-[11px] text-slate-500 uppercase tracking-wider">${item.type} ${catName ? '• ' + catName : ''}</p>
              </div>
            </div>
            <div class="text-right flex-shrink-0">
              <span class="text-xs bg-white text-indigo-600 border border-slate-200 px-2.5 py-1 rounded font-medium shadow-sm">${item.date}${item.time ? ' ' + item.time : ''}</span>
            </div>
          `;
          group.appendChild(row);
        });
        container.appendChild(group);
      }

      document.getElementById('availability-modal').classList.remove('hidden');
    }

