<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Personal Project Organizer</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #CBD5E1;
      border-radius: 3px;
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen flex flex-col">
  <!-- Header -->
  <header class="bg-white border-b border-slate-200 px-6 py-4 flex flex-wrap justify-between items-center gap-4 shadow-sm">
    <div class="flex items-center space-x-3">
      <div class="bg-indigo-600 p-2 rounded-lg shadow-sm">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
      </div>
      <div>
        <h1 class="text-xl font-bold tracking-wide text-slate-900">Personal Organizer</h1>
        <p class="text-xs text-slate-500">Project & Task Manager</p>
      </div>
    </div>

    <!-- Search Input -->
    <div class="flex-1 max-w-xs mx-4">
      <div class="relative">
        <input type="text" id="search-input" oninput="handleSearch()" placeholder="Search active & archived tasks..." class="w-full bg-slate-50 border border-slate-300 rounded-lg pl-9 pr-4 py-1.5 text-sm text-slate-900 focus:outline-none focus:border-indigo-500 focus:bg-white transition">
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </div>
    </div>

    <!-- Navigation & Controls -->
    <div class="flex items-center space-x-3">
      <button onclick="openAvailabilityModal()" class="bg-white hover:bg-slate-50 text-indigo-600 px-3 py-1.5 rounded-lg text-sm font-medium transition flex items-center gap-1.5 border border-indigo-200 shadow-sm">
        <span>📅 Upcoming Availability</span>
      </button>
      <button onclick="openCategoryManagerModal()" class="bg-white hover:bg-slate-50 text-slate-700 px-3 py-1.5 rounded-lg text-sm font-medium transition flex items-center gap-1.5 border border-slate-200 shadow-sm">
        <span>⚙️ Categories</span>
      </button>
      <div class="bg-slate-200 p-1 rounded-lg flex space-x-1">
        <button id="btn-list-view" onclick="switchView('list')" class="px-3 py-1.5 rounded-md text-sm font-medium bg-indigo-600 text-white shadow-sm transition">List</button>
        <button id="btn-calendar-view" onclick="switchView('calendar')" class="px-3 py-1.5 rounded-md text-sm font-medium text-slate-600 hover:text-slate-950 transition">Month</button>
        <button id="btn-day-view" onclick="switchView('day')" class="px-3 py-1.5 rounded-md text-sm font-medium text-slate-600 hover:text-slate-950 transition">Day</button>
        <button id="btn-archive-view" onclick="switchView('archive')" class="px-3 py-1.5 rounded-md text-sm font-medium text-slate-600 hover:text-slate-950 transition">📁 Archive</button>
      </div>
      <button onclick="openModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg font-medium text-sm flex items-center gap-2 shadow-sm transition">
        <span>+ New Job</span>
      </button>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="flex-1 p-6 overflow-hidden flex flex-col">

    <!-- Search Overlay Results -->
    <div id="view-search-results" class="hidden flex-1 bg-white rounded-xl border border-slate-200 shadow-sm p-6 flex flex-col overflow-y-auto custom-scrollbar mb-4">
      <h2 class="text-lg font-bold text-slate-900 mb-4">Search Results</h2>
      <div id="search-results-container" class="space-y-3"></div>
    </div>

    <!-- List View -->
    <div id="view-list" class="flex-1 bg-white rounded-xl border border-slate-200 shadow-sm p-6 flex flex-col overflow-hidden">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-bold text-slate-900">Active Jobs</h2>
        <span id="active-count" class="text-xs bg-slate-100 border border-slate-200 px-3 py-1 rounded-full text-slate-700 font-bold">0 Jobs</span>
      </div>
      <div id="active-job-list" class="flex-1 overflow-y-auto space-y-3 custom-scrollbar pr-1"></div>
    </div>

    <!-- Calendar View (Month) -->
    <div id="view-calendar" class="hidden flex-1 bg-white rounded-xl border border-slate-200 shadow-sm p-6 flex flex-col">
      <div class="flex flex-wrap justify-between items-center mb-6 gap-3">
        <h2 id="calendar-month-year" class="text-xl font-bold text-slate-900"></h2>
        <div class="flex flex-wrap items-center gap-2">
          <!-- Quick Month Jump Dropdown -->
          <select id="month-jump-select" onchange="jumpToMonth(this.value)" class="bg-slate-50 border border-slate-300 rounded-lg px-3 py-1.5 text-sm text-slate-800 focus:outline-none focus:border-indigo-500"></select>
          <button onclick="prevMonth()" class="bg-slate-100 hover:bg-slate-200 border border-slate-300 px-3 py-1.5 rounded-lg text-sm text-slate-700 font-medium">Previous</button>
          <button onclick="todayMonth()" class="bg-slate-100 hover:bg-slate-200 border border-slate-300 px-3 py-1.5 rounded-lg text-sm text-slate-700 font-medium">Today</button>
          <button onclick="nextMonth()" class="bg-slate-100 hover:bg-slate-200 border border-slate-300 px-3 py-1.5 rounded-lg text-sm text-slate-700 font-medium">Next</button>
        </div>
      </div>
      <div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold text-slate-500 mb-2">
        <div>SUN</div><div>MON</div><div>TUE</div><div>WED</div><div>THU</div><div>FRI</div><div>SAT</div>
      </div>
      <div id="calendar-grid" class="flex-1 grid grid-cols-7 grid-rows-6 gap-2 overflow-y-auto custom-scrollbar"></div>
    </div>

    <!-- Dedicated Day View -->
    <div id="view-day" class="hidden flex-1 bg-white rounded-xl border border-slate-200 shadow-sm p-6 flex flex-col overflow-hidden">
      <div class="flex flex-wrap justify-between items-center mb-6 gap-3">
        <div>
          <h2 id="day-view-title" class="text-xl font-bold text-slate-900"></h2>
          <p id="day-view-subtitle" class="text-xs text-slate-500">Detailed schedule & task checklist</p>
        </div>
        <div class="flex items-center gap-2">
          <input type="date" id="day-picker-input" onchange="changeDayPicker(this.value)" class="bg-slate-50 border border-slate-300 rounded-lg px-3 py-1.5 text-sm text-slate-800 focus:outline-none focus:border-indigo-500">
          <button onclick="prevDay()" class="bg-slate-100 hover:bg-slate-200 border border-slate-300 px-3 py-1.5 rounded-lg text-sm text-slate-700 font-medium">Previous Day</button>
          <button onclick="todayDay()" class="bg-slate-100 hover:bg-slate-200 border border-slate-300 px-3 py-1.5 rounded-lg text-sm text-slate-700 font-medium">Today</button>
          <button onclick="nextDay()" class="bg-slate-100 hover:bg-slate-200 border border-slate-300 px-3 py-1.5 rounded-lg text-sm text-slate-700 font-medium">Next Day</button>
        </div>
      </div>
      <div id="day-tasks-container" class="flex-1 overflow-y-auto space-y-3 custom-scrollbar pr-1"></div>
    </div>

    <!-- Completed Archive View -->
    <div id="view-archive" class="hidden flex-1 bg-white rounded-xl border border-slate-200 shadow-sm p-6 flex flex-col overflow-hidden">
      <div class="flex justify-between items-center mb-4">
        <div>
          <h2 class="text-lg font-bold text-slate-900">Completed Archive</h2>
          <p class="text-xs text-slate-500">Completed jobs and subtasks are stored here to keep your calendar & list clean.</p>
        </div>
        <span id="archive-count" class="text-xs bg-emerald-50 border border-emerald-300 text-emerald-700 px-3 py-1 rounded-full font-bold">0 Completed</span>
      </div>
      <div id="archive-job-list" class="flex-1 overflow-y-auto space-y-3 custom-scrollbar pr-1"></div>
    </div>
  </main>

  <!-- Job Edit/Create Modal -->
  <div id="job-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4 z-50 hidden">
    <div class="bg-white border border-slate-200 shadow-xl rounded-xl max-w-2xl w-full max-h-[90vh] flex flex-col overflow-hidden">
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center bg-slate-50">
        <h3 id="modal-title" class="text-lg font-bold text-slate-900">Edit Job</h3>
        <button onclick="closeModal()" class="text-slate-400 hover:text-slate-700 text-xl font-bold">&times;</button>
      </div>

      <!-- Modal Body -->
      <div class="p-6 overflow-y-auto space-y-5 custom-scrollbar flex-1">
        <input type="hidden" id="modal-job-id">
        
        <!-- Job Title & Category -->
        <div class="grid grid-cols-3 gap-4">
          <div class="col-span-2">
            <label class="block text-xs font-medium text-slate-600 mb-1">Job Title</label>
            <input type="text" id="modal-title-input" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm text-slate-900 focus:outline-none focus:border-indigo-500">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Category</label>
            <select id="modal-category-input" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm text-slate-900 focus:outline-none focus:border-indigo-500"></select>
          </div>
        </div>

        <!-- Target Date, Time & Completion Checkbox -->
        <div class="grid grid-cols-3 gap-3 items-center">
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Target Date</label>
            <input type="date" id="modal-date-input" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm text-slate-900 focus:outline-none focus:border-indigo-500">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Target Time</label>
            <input type="time" id="modal-time-input" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm text-slate-900 focus:outline-none focus:border-indigo-500">
          </div>
          <div class="flex items-center pt-5 gap-2">
            <input type="checkbox" id="modal-completed-input" class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-0 cursor-pointer">
            <label for="modal-completed-input" class="text-xs font-medium text-slate-700 cursor-pointer">Completed (Archive)</label>
          </div>
        </div>

        <!-- Notes -->
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Notes & Specifications</label>
          <textarea id="modal-notes-input" rows="3" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm text-slate-900 focus:outline-none focus:border-indigo-500" placeholder="Dimensions, project notes..."></textarea>
        </div>

        <!-- Subtasks Section -->
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-2">Subtasks / Checklist</label>
          <div id="modal-subtasks-container" class="space-y-2 mb-3"></div>
          <div class="grid grid-cols-1 md:grid-cols-4 gap-2">
            <input type="text" id="new-subtask-title" placeholder="Subtask description..." class="md:col-span-2 bg-slate-50 border border-slate-300 rounded-lg p-2 text-sm text-slate-900 focus:outline-none focus:border-indigo-500">
            <input type="date" id="new-subtask-date" class="bg-slate-50 border border-slate-300 rounded-lg p-2 text-sm text-slate-900 focus:outline-none focus:border-indigo-500">
            <div class="flex gap-1">
              <input type="time" id="new-subtask-time" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2 text-sm text-slate-900 focus:outline-none focus:border-indigo-500">
              <button type="button" onclick="addSubtask()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 rounded-lg text-sm font-medium">Add</button>
            </div>
          </div>
        </div>

        <!-- Photos Section -->
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-2">Photos</label>
          <div id="modal-photos-container" class="grid grid-cols-4 gap-3 mb-3"></div>
          <input type="file" id="modal-photo-upload" accept="image/*" class="text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 cursor-pointer">
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex justify-between">
        <button type="button" onclick="deleteJob()" class="bg-red-50 text-red-600 hover:bg-red-100 border border-red-200 px-4 py-2 rounded-lg text-sm font-medium transition">Delete Job</button>
        <div class="flex space-x-2">
          <button type="button" onclick="closeModal()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-4 py-2 rounded-lg text-sm font-medium transition">Cancel</button>
          <button type="button" onclick="saveJob()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition">Save Changes</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Upcoming Availability Modal -->
  <div id="availability-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4 z-50 hidden">
    <div class="bg-white border border-slate-200 shadow-xl rounded-xl max-w-2xl w-full max-h-[85vh] flex flex-col overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200 bg-slate-50 flex justify-between items-center">
        <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2"><span>📅</span> Upcoming Due Dates & Availability</h3>
        <button onclick="closeAvailabilityModal()" class="text-slate-400 hover:text-slate-700 text-xl font-bold">&times;</button>
      </div>
      <div id="availability-content" class="p-6 overflow-y-auto space-y-3 custom-scrollbar flex-1"></div>
      <div class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex justify-end">
        <button onclick="closeAvailabilityModal()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-4 py-2 rounded-lg text-sm font-medium">Close</button>
      </div>
    </div>
  </div>

  <!-- Category Manager Modal -->
  <div id="category-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4 z-50 hidden">
    <div class="bg-white border border-slate-200 shadow-xl rounded-xl max-w-md w-full flex flex-col overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200 bg-slate-50 flex justify-between items-center">
        <h3 class="text-lg font-bold text-slate-900">Manage Categories</h3>
        <button onclick="closeCategoryManagerModal()" class="text-slate-400 hover:text-slate-700 text-xl font-bold">&times;</button>
      </div>

      <div class="p-6 space-y-4">
        <!-- Create Category -->
        <div class="flex gap-2 items-center">
          <input type="text" id="new-cat-name" placeholder="New Category Name..." class="flex-1 bg-slate-50 border border-slate-300 rounded-lg p-2 text-sm text-slate-900 focus:outline-none focus:border-indigo-500">
          <input type="color" id="new-cat-color" value="#6366f1" class="h-9 w-10 bg-slate-50 border border-slate-300 rounded cursor-pointer p-0.5">
          <button onclick="addCategory()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 rounded-lg text-sm font-medium">Add</button>
        </div>

        <!-- Category List -->
        <div id="category-list" class="space-y-2 max-h-60 overflow-y-auto custom-scrollbar pt-2"></div>
      </div>
    </div>
  </div>

  <script>
    let categories = JSON.parse(localStorage.getItem('personal_organizer_categories')) || [
      { id: 'cat-work', name: 'Work', color: '#2563eb' },
      { id: 'cat-youtube', name: 'YouTube', color: '#dc2626' },
      { id: 'cat-cong', name: 'Cong', color: '#7c3aed' },
      { id: 'cat-house', name: 'House', color: '#059669' },
      { id: 'cat-bills', name: 'Bills', color: '#d97706' }
    ];

    let jobs = JSON.parse(localStorage.getItem('personal_organizer_jobs')) || [
      {
        id: '1',
        title: 'Workbench Build',
        category: 'cat-house',
        completed: false,
        date: '2026-11-20',
        time: '09:00',
        notes: '2000mm x 800mm timber frame build.',
        photos: [],
        subtasks: [
          { id: 's1', title: 'Cut framing timber', due: '2026-11-12', time: '10:30', completed: false },
          { id: 's2', title: 'Assemble base', due: '2026-11-15', time: '14:00', completed: true }
        ]
      }
    ];

    let currentView = 'list';
    let currentCalendarDate = new Date();
    let currentDayDate = new Date();

    function saveData() {
      localStorage.setItem('personal_organizer_jobs', JSON.stringify(jobs));
      localStorage.setItem('personal_organizer_categories', JSON.stringify(categories));
      render();
    }

    function render() {
      populateCategorySelects();
      renderListView();
      renderCalendar();
      renderDayView();
      renderArchiveView();
    }

    function populateCategorySelects() {
      const select = document.getElementById('modal-category-input');
      select.innerHTML = '';
      categories.forEach(cat => {
        const opt = document.createElement('option');
        opt.value = cat.id;
        opt.innerText = cat.name;
        select.appendChild(opt);
      });
    }

    function renderListView() {
      const activeContainer = document.getElementById('active-job-list');
      activeContainer.innerHTML = '';

      const activeJobs = jobs.filter(j => !j.completed);
      document.getElementById('active-count').innerText = `${activeJobs.length} Jobs`;

      if (activeJobs.length === 0) {
        activeContainer.innerHTML = `<div class="text-center py-12 text-slate-400 text-sm">No active jobs right now.</div>`;
        return;
      }

      activeJobs.forEach(job => {
        const item = createJobRow(job);
        activeContainer.appendChild(item);
      });
    }

    function renderArchiveView() {
      const archiveContainer = document.getElementById('archive-job-list');
      archiveContainer.innerHTML = '';

      const archivedJobs = jobs.filter(j => j.completed);
      document.getElementById('archive-count').innerText = `${archivedJobs.length} Completed`;

      if (archivedJobs.length === 0) {
        archiveContainer.innerHTML = `<div class="text-center py-12 text-slate-400 text-sm">No completed jobs in archive.</div>`;
        return;
      }

      archivedJobs.forEach(job => {
        const item = createJobRow(job, true);
        archiveContainer.appendChild(item);
      });
    }

    function createJobRow(job, isArchive = false) {
      const el = document.createElement('div');
      el.className = 'bg-slate-50 border border-slate-200 rounded-lg p-4 cursor-pointer hover:border-indigo-500 transition shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4';
      el.onclick = (e) => {
        if (!e.target.classList.contains('checkbox-toggle')) {
          openModal(job.id);
        }
      };

      const cat = categories.find(c => c.id === job.category);
      const catColor = cat ? cat.color : '#6b7280';
      const catName = cat ? cat.name : 'Uncategorized';

      const subtaskCount = job.subtasks.length;
      const activeSubtasks = job.subtasks.filter(s => !s.completed);
      const completedSubtasksCount = job.subtasks.filter(s => s.completed).length;

      let subtaskSummaryHtml = '';
      if (subtaskCount > 0) {
        subtaskSummaryHtml = `
          <div class="text-xs text-slate-500 mt-2 flex flex-wrap gap-2 items-center">
            <span class="bg-white px-2 py-0.5 rounded border border-slate-200 shadow-sm">Subtasks: ${completedSubtasksCount}/${subtaskCount}</span>
            ${activeSubtasks.map(s => `<span class="bg-white text-slate-700 px-2 py-0.5 rounded border border-slate-200 text-[11px]">• ${s.title} ${s.due ? `(${s.due}${s.time ? ' ' + s.time : ''})` : ''}</span>`).join('')}
          </div>
        `;
      }

      let photoBadge = '';
      if (job.photos && job.photos.length > 0) {
        photoBadge = `<span class="text-xs bg-white text-slate-600 px-2 py-0.5 rounded border border-slate-200 shadow-sm">📷 ${job.photos.length}</span>`;
      }

      const dateTimeStr = job.date ? `Due: ${job.date}${job.time ? ' at ' + job.time : ''}` : '';

      el.innerHTML = `
        <div class="flex-1">
          <div class="flex items-center gap-3">
            <input type="checkbox" ${job.completed ? 'checked' : ''} onclick="toggleJobCompleted('${job.id}', event)" class="checkbox-toggle w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-0 cursor-pointer">
            <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background-color: ${catColor}"></span>
            <h4 class="font-semibold text-slate-900 text-base ${job.completed ? 'line-through text-slate-400' : ''}">${job.title}</h4>
            <span class="text-[10px] font-semibold tracking-wider uppercase text-slate-600 bg-white border border-slate-200 px-2 py-0.5 rounded shadow-sm">${catName}</span>
          </div>
          ${job.notes ? `<p class="text-xs text-slate-500 mt-1 pl-7 line-clamp-1">${job.notes}</p>` : ''}
          <div class="pl-7">${subtaskSummaryHtml}</div>
        </div>

        <div class="flex items-center gap-3 pl-7 md:pl-0">
          ${photoBadge}
          ${dateTimeStr ? `<span class="text-xs bg-white text-slate-700 border border-slate-200 px-2.5 py-1 rounded shadow-sm">${dateTimeStr}</span>` : ''}
        </div>
      `;
      return el;
    }

    function toggleJobCompleted(id, event) {
      event.stopPropagation();
      const job = jobs.find(j => j.id === id);
      if (job) {
        job.completed = !job.completed;
        saveData();
      }
    }

    function switchView(view) {
      currentView = view;
      document.getElementById('view-list').classList.add('hidden');
      document.getElementById('view-calendar').classList.add('hidden');
      document.getElementById('view-day').classList.add('hidden');
      document.getElementById('view-archive').classList.add('hidden');
      document.getElementById('view-search-results').classList.add('hidden');

      document.getElementById('btn-list-view').className = 'px-3 py-1.5 rounded-md text-sm font-medium text-slate-600 hover:text-slate-950 transition';
      document.getElementById('btn-calendar-view').className = 'px-3 py-1.5 rounded-md text-sm font-medium text-slate-600 hover:text-slate-950 transition';
      document.getElementById('btn-day-view').className = 'px-3 py-1.5 rounded-md text-sm font-medium text-slate-600 hover:text-slate-950 transition';
      document.getElementById('btn-archive-view').className = 'px-3 py-1.5 rounded-md text-sm font-medium text-slate-600 hover:text-slate-950 transition';

      if (view === 'list') {
        document.getElementById('view-list').classList.remove('hidden');
        document.getElementById('btn-list-view').className = 'px-3 py-1.5 rounded-md text-sm font-medium bg-indigo-600 text-white shadow-sm transition';
      } else if (view === 'calendar') {
